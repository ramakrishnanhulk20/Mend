# Copy to .env and fill in. Sandbox only: Mend refuses to start with anything else.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# The id PayPal gives when the web app's webhook is registered (not secret)
PAYPAL_WEBHOOK_ID=

# A second sandbox app on the same business account, used only for the AI agent's PayPal reads. Create it with Payouts NOT ticked.
PAYPAL_READ_CLIENT_ID=
PAYPAL_READ_CLIENT_SECRET=

# Database. Leave empty in local development to use the bundled pgserver database.
DATABASE_URL=

# Local development only
MEND_DEV=1
# A sandbox personal account email that receives the proof payout
MEND_TEST_RECEIVER=

# Money caps in USD cents
MEND_PAYOUT_ITEM_CAP_MINOR=1000
MEND_CAMPAIGN_CAP_MINOR=10000
MEND_DAILY_CAP_MINOR=20000
# USD cents every payout must leave in the shop's PayPal balance. Empty means 25000.
MEND_BALANCE_FLOOR_MINOR=

# Owner sign-in for the console (choose a long random value)
MEND_OWNER_PASSWORD=

# Render API key for the deploy script (Render dashboard > Account Settings > API Keys)
RENDER_API_KEY=

# Claude API key (platform.claude.com > Settings > API Keys), with prepaid credit. Required: npm run dev:console will not start without it.
ANTHROPIC_API_KEY=

# AG Studio licence key (the key AG Grid emailed after the trial form at ag-grid.com/studio/license-pricing). Read on the server, passed to the browser as a prop, never NEXT_PUBLIC_.
AG_STUDIO_LICENSE_KEY=
