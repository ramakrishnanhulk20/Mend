# Copy to .env and fill in. Sandbox only: Mend refuses to start with anything else.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# The id PayPal gives when the web app's webhook is registered (not secret)
PAYPAL_WEBHOOK_ID=

# Database. Leave empty in local development to use the bundled pgserver database.
DATABASE_URL=

# Local development only
MEND_DEV=1
# A sandbox personal account email that receives the proof payout
MEND_TEST_RECEIVER=

# Money caps in USD cents
MEND_PAYOUT_ITEM_CAP_MINOR=1000
MEND_CAMPAIGN_CAP_MINOR=10000
MEND_DAILY_CAP_MINOR=20000

# Owner sign-in for the console (choose a long random value)
MEND_OWNER_PASSWORD=
