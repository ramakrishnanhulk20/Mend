# The web app reads these from the process environment. It refuses to start unless PAYPAL_ENV is sandbox.
PAYPAL_ENV=sandbox
# PayPal sandbox app credentials (developer.paypal.com, Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id PayPal returned when this app's /api/webhooks/paypal address was registered
PAYPAL_WEBHOOK_ID=
# postgresql:// URL. Locally: run `python -m mend_engine.db.dev_url` in packages/engine and paste its output
DATABASE_URL=
# This app's own public origin, for example https://mend.onrender.com. Same-origin checks and cookie flags come from it, never from request headers
MEND_BASE_URL=
# Owner console password, at least 16 characters (choose a long random value; never published)
MEND_OWNER_PASSWORD=
# Key that signs each session's CSRF token, at least 32 bytes (node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"); every route refuses without it
MEND_CSRF_SECRET=
# Anthropic API key for the AI parts (platform.claude.com > API Keys). Server only, never NEXT_PUBLIC_. Leave empty and the rest of Mend still works
ANTHROPIC_API_KEY=
# The engine's Render private network address: http, a one-word host name and a port, for example http://mend-engine-abcd:10000 (its service page, Connect > Internal). Server only
MEND_ENGINE_URL=
# A random value of 32 or more characters, given to both this app and the engine service; the engine refuses every call without it
MEND_ENGINE_TOKEN=
# Local development only: 1 sends engine tasks to the dev bridge on this machine instead of Render, and allows an http://127.0.0.1 MEND_BASE_URL
MEND_DEV=
# Local development only: the dev bridge's address, for example http://127.0.0.1:8765 (python -m mend_engine.dev_bridge)
MEND_BRIDGE_URL=
# Local development only: a random value of 32 or more characters, given to both this app and the dev bridge
MEND_BRIDGE_TOKEN=
